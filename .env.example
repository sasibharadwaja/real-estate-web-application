# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: API Key from Resend (https://resend.com) for reliable real email delivery
RESEND_API_KEY=""

# Optional: Recipient business email address for consultation leads (defaults to bmsrao2001@gmail.com)
BUSINESS_EMAIL="bmsrao2001@gmail.com"

# Optional: Verified sender email address configured in Resend (default: PlotStories Consultation <onboarding@resend.dev>)
RESEND_FROM_EMAIL="PlotStories Consultation <onboarding@resend.dev>"
